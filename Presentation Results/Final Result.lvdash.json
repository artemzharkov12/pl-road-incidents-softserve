{
  "datasets": [
    {
      "name": "47712f67",
      "displayName": "Regional Traffic Incident Events and Timing Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    f.accident_id,\r\n",
        "    f.start_longitude,\r\n",
        "    f.start_latitude,\r\n",
        "    e.icon_category,\r\n",
        "    e.event_type_description,\r\n",
        "    e.impact_jams,\r\n",
        "    t.date,\r\n",
        "    t.hour\r\n",
        "FROM dbr_dev_trial.prod.gold_fact_accidents_streaming_road_accidents f\r\n",
        "JOIN dbr_dev_trial.prod.gold_dim_event_type_streaming_road_accidents e \r\n",
        "  ON f.event_type_key = e.event_type_key\r\n",
        "JOIN dbr_dev_trial.prod.gold_dim_time_streaming_road_accidents t \r\n",
        "  ON f.date_key = t.date_key\r\n",
        "WHERE f.start_latitude BETWEEN 49.00 AND 54.84\r\n",
        "  AND f.start_longitude BETWEEN 14.12 AND 24.15"
      ],
      "catalog": "dbr_dev",
      "schema": "default"
    }
  ],
