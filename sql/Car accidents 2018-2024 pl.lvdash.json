{
  "datasets": [
    {
      "name": "b50c8d3f",
      "displayName": "Location of car accidents",
      "queryLines": [
        "SELECT \r\n",
        "    ROUND(f.gps_x, 4) AS lon_bucket,\r\n",
        "    ROUND(f.gps_y, 4) AS lat_bucket,\r\n",
        "    COUNT(f.accident_id) AS total_accidents,\r\n",
        "    SUM(f.total_injured) AS total_injured_people\r\n",
        "FROM gold_fact_accident_summary f\r\n",
        "WHERE f.gps_x IS NOT NULL AND f.gps_y IS NOT NULL\r\n",
        "GROUP BY ALL"
      ],
      "catalog": "dbr_dev",
      "schema": "artemzharkov10_gold"
    },
    {
      "name": "c053aa46",
      "displayName": "Season",
      "queryLines": [
        "SELECT \r\n",
        "    d.season,\r\n",
        "    YEAR(summary.accident_timestamp) AS accident_year,\r\n",
        "    COUNT(summary.accident_id) AS total_accidents\r\n",
        "FROM gold_fact_accident_summary summary\r\n",
        "JOIN gold_dim_date d ON summary.date_id = d.date_id\r\n",
        "GROUP BY ALL"
      ],
      "catalog": "dbr_dev",
      "schema": "artemzharkov10_gold"
    },
    {
      "name": "40f6f956",
      "displayName": "Car brand and car type",
      "queryLines": [
        "SELECT \r\n",
        "    SUBSTRING_INDEX(vechicle.brand, ' ', 1) AS brand,\r\n",
        "    COUNT(details.accident_id) AS total_accidents\r\n",
        "FROM gold_fact_accident_details details\r\n",
        "JOIN gold_dim_vehicle vechicle ON details.vehicle_id = vechicle.vehicle_id\r\n",
        "WHERE vechicle.brand IS NOT NULL\r\n",
        "GROUP BY ALL\r\n",
        "HAVING COUNT(details.accident_id) > 10000"
      ],
      "catalog": "dbr_dev",
      "schema": "artemzharkov10_gold"
    },
    {
      "name": "a2ce2abc",
      "displayName": "Demographics",
      "queryLines": [
        "SELECT \r\n",
        "    participant.gender,\r\n",
        "    participant.driving_experience_years AS experience_years,\r\n",
        "    COUNT(details.accident_id) AS total_accidents\r\n",
        "FROM gold_fact_accident_details details\r\n",
        "JOIN gold_dim_participant participant ON details.participant_id = participant.participant_id\r\n",
        "GROUP BY ALL\r\n",
        "HAVING COUNT(details.accident_id) > 300"
      ],
      "catalog": "dbr_dev",
      "schema": "artemzharkov10_gold"
    },
    {
      "name": "171f4989",
      "displayName": "Holidays and Alcohol",
      "queryLines": [
        "SELECT \r\n",
        "    d.is_holiday,\r\n",
        "    COUNT(DISTINCT summary.accident_id) AS total_accidents,\r\n",
        "    COUNT(DISTINCT d.full_date) AS total_days,\r\n",
        "    ROUND(COUNT(DISTINCT summary.accident_id) / COUNT(DISTINCT d.full_date), 0) AS avg_accidents_per_day,\r\n",
        "    COUNT_IF(details.is_alcohol = True) AS alcohol_drivers,\r\n",
        "    ROUND(COUNT(DISTINCT CASE WHEN details.is_alcohol = True THEN summary.accident_id END) / COUNT(DISTINCT d.full_date), 2) AS avg_alcohol_accidents_per_day,\r\n",
        "    ROUND(AVG(NULLIF(details.blood_alcohol_level, 0)), 2) AS avg_blood_alcohol_level\r\n",
        "\r\n",
        "FROM gold_fact_accident_summary summary\r\n",
        "JOIN gold_dim_date d ON summary.date_id = d.date_id\r\n",
        "JOIN gold_fact_accident_details details ON summary.accident_id = details.accident_id\r\n",
        "GROUP BY d.is_holiday"
      ],
      "catalog": "dbr_dev",
      "schema": "artemzharkov10_gold"
    }
  ],
